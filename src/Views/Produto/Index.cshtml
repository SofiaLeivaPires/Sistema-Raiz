@model IEnumerable<Produto>

<h1>Produtos</h1>

<a asp-action="Create" class="btn btn-primary">Adicionar Novo Produto</a>

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ação</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@produto.ProdutoId" class="btn btn-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@produto.ProdutoId" class="btn btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>